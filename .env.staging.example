ENVIRONMENT=staging
PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@supabase-db:5432/postgres
SUPABASE_URL=https://supabase-staging.example.com
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://supabase-staging.example.com/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
ALLOW_UNAUTHENTICATED_DEV=false
USE_IN_MEMORY_STORE=false
CORS_ORIGINS=
TRUST_PROXY_HEADERS=true
RATE_LIMIT_PER_MINUTE=120
SENSITIVE_RATE_LIMIT_PER_MINUTE=30
MEDIA_RATE_LIMIT_PER_MINUTE=10
SOS_RATE_LIMIT_PER_HOUR=3
MEDIA_BUCKET=incident-media
MAX_MEDIA_BYTES=10000000
NTFY_BASE_URL=https://ntfy-staging.example.com
NTFY_TOPIC=dey-alert-staging
NTFY_ACCESS_TOKEN=replace-with-a-publish-only-token
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_SENDER_ID=DeyAlert
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
METRICS_TOKEN=replace-with-a-long-random-secret
NEWS_FEEDS_JSON=[]
NEWS_ADMIN_EMAILS=
NEWS_AUTO_PUBLISH=false

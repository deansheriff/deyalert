APP_NAME=Dey Alert API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/dey_alert
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional Flutter fallback for older Supabase projects:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required only when Supabase still issues legacy HS256 tokens:
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
CORS_ORIGINS=
ALLOW_UNAUTHENTICATED_DEV=true
USE_IN_MEMORY_STORE=false
NTFY_TOPIC=dey-alert-dev
FLAG_HIDE_THRESHOLD=5
CORROBORATION_THRESHOLD=3
CORROBORATION_RADIUS_KM=2.0
